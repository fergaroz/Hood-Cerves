generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Person {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  drinks    Drink[]
}

model Drink {
  id        String   @id @default(cuid())
  liters    Float
  createdAt DateTime @default(now())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  String

  @@index([personId])
}
